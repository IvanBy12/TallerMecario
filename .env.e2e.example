# Variables PRIVADAS del runner E2E móvil (Sprint 3). Solo nombres: NUNCA escribas valores en este archivo.
# Para uso local copia a `.env.e2e` (ignorado por git; playwright.config.ts lo carga si existe)
# o exporta las variables en el shell / secrets del runner. Detalle: docs/quality/s3-mobile-e2e.md
#
# El E2E es REAL: habla con el backend, Clerk, PostgreSQL y R2 del ambiente de PRUEBA. No lo apuntes a producción
# (el harness se niega a correr con una clave Clerk pk_live_).

# --- Públicas del frontend (mismas que .env.example; las consume `npm run dev` y el harness) ---
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=

# --- Frontend bajo prueba (opcional) ---
# Si se omite, Playwright arranca `npm run dev` en http://localhost:5173. Si se define, se usa ese origen ya desplegado.
E2E_BASE_URL=

# --- Taller A: asesor/owner con exactamente UNA membership activa (E2E-01, 02, 03, 04, 05) ---
E2E_TENANT_ID=
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# --- Taller A: técnico (permisos reducidos), exactamente UNA membership activa (E2E-04) ---
E2E_RESTRICTED_EMAIL=
E2E_RESTRICTED_PASSWORD=

# --- Taller B: usuario con membership SOLO en B y una recepción REAL de B (E2E-05) ---
E2E_TENANT_B_ID=
E2E_TENANT_B_USER_EMAIL=
E2E_TENANT_B_USER_PASSWORD=
E2E_TENANT_B_RECEPTION_ID=
# Opcional: texto distintivo presente en esa recepción de B (p. ej. sus observaciones) para afirmar que no se filtra.
E2E_TENANT_B_SENTINEL=

# --- Opcionales ---
# Código de verificación de Clerk si el ambiente lo pide (usuarios de prueba `+clerk_test`: ver docs de Clerk).
E2E_VERIFICATION_CODE=
# Placa de un vehículo ya existente en el taller A. Si se omite, cada corrida crea cliente y vehículo con sufijo único.
E2E_VEHICLE_PLATE=
