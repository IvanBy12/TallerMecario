# Solo configuración PÚBLICA. Todo valor VITE_* se incrusta en el bundle del navegador.
# NUNCA escribas secretos, tokens, claves privadas ni credenciales aquí ni en ningún .env.
# Para overrides locales copia este archivo a .env.local (ignorado por git).

# Opcional. Valores: local | staging | production
# Si no se define: "local" en el servidor de desarrollo, "production" en el build de producción.
VITE_APP_ENV=local

# Obligatoria para que la autenticación funcione. ORIGEN del backend: esquema + host + puerto opcional (p. ej. https://api.ejemplo.com).
# Solo se acepta la ruta "/" (o ninguna): no incluyas rutas ni prefijos de versión.
# Sin credenciales, '?' ni '#'. Se normaliza a origen (minúsculas, sin puerto por defecto ni "/" final).
# Se permite http solo cuando VITE_APP_ENV=local.
# La consume el cliente HTTP de autenticación como origen de las peticiones (solo GET /api/v1/…).
VITE_API_BASE_URL=

# Obligatoria para que la autenticación funcione. Es la clave PUBLICABLE de Clerk
# (pk_test_… en local/staging, pk_live_… en producción); es pública por diseño.
# NUNCA escribas aquí la secret key (CLERK_SECRET_KEY) ni ninguna clave privada.
# Si falta o es inválida, la aplicación muestra una pantalla de configuración y no monta Clerk.
# Sin valor por defecto: sin ella no hay sesión.
VITE_CLERK_PUBLISHABLE_KEY=
