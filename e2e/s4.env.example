# S4 only: copy to the ignored .env.e2e or inject process env. Never commit actual values.
# Public config may instead come from .env in this worktree or E2E_S4_PUBLIC_ENV_FILE.
VITE_API_BASE_URL=
VITE_CLERK_PUBLISHABLE_KEY=
E2E_S4_PUBLIC_ENV_FILE=
E2E_S4_R2_ORIGIN=
E2E_S4_SANDBOX_FILE=
# Optional Vite Development frontend with exact sandbox origin and inspectable /src/main.tsx.
# No local server is started for E2E_BASE_URL; uninspectable static builds are BLOCKED.
# Omitted = local Vite with reuseExistingServer=false and strict port.
E2E_BASE_URL=
# Optional explicit manual Development login; CI forbids it. No email/password/tenant ID variables required.
E2E_S4_INTERACTIVE_LOGIN=0
# Private sandbox JSON retains existing fields: environment=test, production=false,
# postgresqlFixturesValidated=true, frontendOrigin, apiOrigin, r2Origin.
# The DB attestation allows synthetic resources in the test DB; no historical identities or IDs required.

# S4 preflight allows local/development/test (trim+lowercase). Absent/blank uses local.
# The current product env contract accepts local/staging/production: use local for this app.
