{
  "name": "tallermecario-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:harness": "vitest run --config e2e-harness-tests/vitest.config.ts",
    "e2e": "playwright test",
    "e2e:mobile": "playwright test --project=mobile-chromium",
    "e2e:headed": "playwright test --project=mobile-chromium --headed",
    "e2e:list": "playwright test --list"
  },
  "dependencies": {
    "@clerk/react": "~6.17.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "~7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "~22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
